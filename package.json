{
  "name": "lab-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run build:test && playwright test",
    "test:only": "playwright test",
    "build:test": "BASE_PATH=/base-test PREVIEW_THEMES=true astro build",
    "pubs": "node scripts/fetch-publications.mjs",
    "hero:data": "node scripts/make-hero-data.mjs",
    "screens": "node scripts/screens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
