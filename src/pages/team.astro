---
import { getSiteData, getTeamData } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import Print from '../components/Print.astro';
import GroupPlaceholder from '../components/GroupPlaceholder.astro';

const site = await getSiteData();
const data = await getTeamData();
const { sectionTitles: t, labels } = site;
---

<Layout title={data.title}>
  <h1>{data.title}</h1>

  <section class="photos" aria-label={t.groupPhotos}>
    {data.photos.length > 0 ? (
      data.photos.map((photo) => <Print figure={photo} sizes="(min-width: 1400px) 76rem, 100vw" />)
    ) : (
      <GroupPlaceholder count={data.current.length} caption={data.photoPlaceholderCaption} />
    )}
  </section>

  <section class="block" aria-labelledby="team-current">
    <h2 id="team-current">{t.currentMembers}</h2>
    <ul class="members">
      {data.current.map((m) => (
        <li>
          <Portrait member={m} />
          <p class="name">{m.name}</p>
          <p class="role">{m.role}</p>
          {m.bioHtml && <div class="bio" set:html={m.bioHtml} />}
          {m.links.length > 0 && (
            <ul class="links">
              {m.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="team-alumni">
    <h2 id="team-alumni">{t.alumni}</h2>
    {data.alumni.length > 0 ? (
      <table class="alumni">
        <thead>
          <tr>
            <th scope="col">{labels.alumni.name}</th>
            <th scope="col">{labels.alumni.role}</th>
            <th scope="col">{labels.alumni.next}</th>
          </tr>
        </thead>
        <tbody>
          {data.alumni.map((m) => (
            <tr>
              <th scope="row">{m.name}</th>
              <td>{m.role}</td>
              <td data-label={labels.alumni.next}>{m.nextPosition ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="empty">{labels.noAlumni}</p>
    )}
  </section>
</Layout>

<style>
  .block {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .block > h2 {
    margin-bottom: 1.75rem;
  }
  .members {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem calc(var(--gutter) * 1.5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .name {
    margin: 0.75rem 0 0;
    font-weight: 700;
  }
  .role {
    margin: 0 0 0.6rem;
    color: var(--overprint-soft);
  }
  .bio {
    font-size: var(--s-1);
    line-height: 1.5;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--s-1);
  }
  .links a {
    display: inline-block;
    padding-block: 4px;
  }
  .photos {
    display: grid;
    gap: 2rem;
    margin-top: 1.75rem;
  }
  /* Full width, trimmed top and bottom to 16:9; anchored low so faces stay in frame. */
  .photos :global(.plate img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 75%;
  }
  /* Alumni as a small register: name, position in the lab, where they went next. */
  .alumni {
    width: 100%;
    max-width: 52rem;
    border-collapse: collapse;
  }
  .alumni th,
  .alumni td {
    padding: 0.55rem 1.5rem 0.55rem 0;
    border-bottom: 1px solid var(--blue-tint);
    text-align: left;
    vertical-align: baseline;
  }
  .alumni thead th {
    padding-top: 0;
    border-bottom: 2px solid var(--pink);
    color: var(--overprint-soft);
    font-size: var(--s-1);
    font-weight: 400;
  }
  .alumni tbody th {
    font-weight: 700;
  }
  @media (max-width: 719px) {
    /* One person per block on phones: name, then role and next position on their own lines. */
    .alumni thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .alumni tr,
    .alumni th,
    .alumni td {
      display: block;
    }
    .alumni tr {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--blue-tint);
    }
    .alumni th,
    .alumni td {
      padding: 0;
      border: 0;
    }
    .alumni td:empty {
      display: none;
    }
    .alumni td[data-label]::before {
      content: attr(data-label) ': ';
      color: var(--overprint-soft);
    }
  }
  .empty {
    color: var(--overprint-soft);
  }
  @media (max-width: 1199px) {
    .members {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 719px) {
    .members {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
