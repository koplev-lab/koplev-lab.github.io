---
import { getSiteData, getTeamData } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import Portrait from '../components/Portrait.astro';

const site = await getSiteData();
const data = await getTeamData();
const { sectionTitles: t, labels } = site;
---

<Layout title={data.title}>
  <h1>{data.title}</h1>

  <section class="block" aria-labelledby="team-current">
    <h2 id="team-current">{t.currentMembers}</h2>
    <ul class="members">
      {data.rows.map((row) =>
        row.map((m, i) => (
          <li class={i === 0 ? 'row-start' : undefined}>
            <Portrait member={m} />
            <p class="name">
              {m.name} <DraftMark placeholder={m.placeholder} />
            </p>
            <p class="role">{m.role}</p>
            {m.bioHtml && <div class="bio" set:html={m.bioHtml} />}
            {m.links.length > 0 && (
              <ul class="links">
                {m.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        )),
      )}
    </ul>
  </section>

  <section class="block" aria-labelledby="team-alumni">
    <h2 id="team-alumni">{t.alumni}</h2>
    {data.alumni.length > 0 ? (
      <ul class="alumni">
        {data.alumni.map((m) => (
          <li>
            <strong>{m.name}</strong> {m.role}
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">{labels.noAlumni}</p>
    )}
  </section>
</Layout>

<style>
  .block {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .block > h2 {
    margin-bottom: 1.75rem;
  }
  .members {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem calc(var(--gutter) * 1.5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each lower role starts a new line. */
  .row-start {
    grid-column-start: 1;
  }
  .name {
    margin: 0.75rem 0 0;
    font-weight: 700;
  }
  .role {
    margin: 0 0 0.6rem;
    color: var(--overprint-soft);
  }
  .bio {
    font-size: var(--s-1);
    line-height: 1.5;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--s-1);
  }
  .links a {
    display: inline-block;
    padding-block: 4px;
  }
  .alumni {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .empty {
    color: var(--overprint-soft);
  }
  @media (max-width: 1199px) {
    .members {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 719px) {
    .members {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
