---
/**
 * Renders one page with a given theme. Used by every route, so routes stay
 * a few lines long. Not part of any theme.
 */
import { PREVIEW_THEMES } from 'astro:env/server';
import type { ThemeContext } from '../../themes/contract';
import type { ThemeId } from '../../themes/ids';
import { themeList, themes } from '../../themes';
import {
  getAboutData,
  getHomeData,
  getJoinData,
  getProjectData,
  getPublicationsData,
  getResearchData,
  getSiteData,
  getTeamData,
} from '../content';
import { pathFor, type PageKind } from '../pages';
import { makeUrl, previewPrefix } from '../url';

interface Props {
  kind: PageKind;
  themeId: ThemeId;
  slug?: string | undefined;
  /** Render under /themes/<id>/ with the preview switcher. */
  inPreview?: boolean;
}

const { kind, themeId, slug, inPreview = false } = Astro.props;
const theme = themes[themeId];
const base = import.meta.env.BASE_URL;
const currentPath = pathFor(kind, slug);

const ctx: ThemeContext = {
  url: makeUrl(base, inPreview ? previewPrefix(themeId) : ''),
  themeId,
  site: await getSiteData(),
  currentPath,
  showDrafts: import.meta.env.DEV || PREVIEW_THEMES,
  preview: inPreview
    ? {
        themes: themeList.map((t) => ({ id: t.id, name: t.name })),
        indexUrl: makeUrl(base)('/themes/'),
        urls: Object.fromEntries(
          themeList.map((t) => [t.id, makeUrl(base, previewPrefix(t.id))(currentPath)]),
        ),
      }
    : null,
};

const P = theme.pages;
---

{kind === 'home' && <P.Home ctx={ctx} data={await getHomeData()} />}
{kind === 'research' && <P.Research ctx={ctx} data={await getResearchData()} />}
{kind === 'project' && <P.Project ctx={ctx} data={await getProjectData(slug!)} />}
{kind === 'publications' && <P.Publications ctx={ctx} data={await getPublicationsData()} />}
{kind === 'team' && <P.Team ctx={ctx} data={await getTeamData()} />}
{kind === 'about' && <P.About ctx={ctx} data={await getAboutData()} />}
{kind === 'join' && <P.Join ctx={ctx} data={await getJoinData()} />}
{kind === 'notFound' && <P.NotFound ctx={ctx} />}
