---
/** The /themes/ index page in preview mode. Neutral, not part of any theme. */
import { themeList } from '../../themes';
import { makeUrl, previewPrefix } from '../url';
import { getSiteData } from '../content';

const base = import.meta.env.BASE_URL;
const site = await getSiteData();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Theme preview · {site.labName}</title>
  </head>
  <body>
    <main>
      <h1>Theme preview</h1>
      <p>The same content rendered with each registered theme.</p>
      <ul>
        {themeList.map((t) => (
          <li>
            <a href={makeUrl(base, previewPrefix(t.id))('/')}>{t.name}</a> <code>{t.id}</code>
          </li>
        ))}
      </ul>
    </main>
    <style is:inline>
      body {
        margin: 2rem 1rem;
        background: #ffffff;
        color: #1a1a1a;
        font:
          16px/1.5 ui-sans-serif,
          system-ui,
          sans-serif;
      }
      main {
        max-width: 40rem;
      }
      a {
        color: #1a1a1a;
      }
    </style>
  </body>
</html>
