---
import type { ThemeContext } from '../../contract';
import Layout from '../Layout.astro';
import EmptyAxes from '../components/EmptyAxes.astro';

interface Props {
  ctx: ThemeContext;
}
const { ctx } = Astro.props;
const { notFound } = ctx.site.labels;
const home = ctx.site.nav.find((n) => n.key === 'home')!;
---

<Layout ctx={ctx} title={notFound.title}>
  <div class="nf">
    <div class="plot">
      <EmptyAxes />
    </div>
    <div>
      <h1>{notFound.title}</h1>
      <p>{notFound.body}</p>
      <p>
        <a href={ctx.url(home.path)}>{home.label}</a>
      </p>
    </div>
  </div>
</Layout>

<style>
  .nf {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--gutter) calc(var(--gutter) * 3);
    align-items: end;
    max-width: 60rem;
  }
  .plot {
    aspect-ratio: 4 / 3;
  }
  h1 {
    margin-bottom: 0.75rem;
    font-size: var(--s3);
    font-weight: 400;
    line-height: 1.18;
  }
  @media (max-width: 759px) {
    .nf {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
