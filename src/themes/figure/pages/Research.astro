---
import type { ThemeContext } from '../../contract';
import type { ResearchData } from '../../../lib/types';
import Layout from '../Layout.astro';
import Caption from '../components/Caption.astro';
import DraftMark from '../components/DraftMark.astro';
import FigImage from '../components/FigImage.astro';
import Panel from '../components/Panel.astro';
import { figureNumber, panels } from '../lib';

interface Props {
  ctx: ThemeContext;
  data: ResearchData;
}
const { ctx, data } = Astro.props;
const fig = figureNumber(ctx.site.nav, ctx.currentPath);
const P = panels(data.projects.map((p) => p.title));
---

<Layout ctx={ctx} title={data.title} description={data.lede}>
  <header class="page-head">
    <h1>{data.title}</h1>
    <p class="lede">
      {data.lede} <DraftMark ctx={ctx} placeholder={data.placeholder} />
    </p>
    {data.introHtml && <div class="prose" set:html={data.introHtml} />}
  </header>

  <div class="mosaic research">
    {data.projects.map((p, i) => (
      <Panel letter={P[i]!.letter} title={p.title} class={i === 0 ? 'lead' : 'side'}>
        <DraftMark ctx={ctx} placeholder={p.placeholder} slot="mark" />
        <FigImage
          figure={p.figure}
          ratio={i === 0 ? undefined : '16 / 9'}
          sizes={i === 0 ? '(min-width: 1100px) 46rem, 100vw' : '(min-width: 1100px) 30rem, 100vw'}
          caption={i === 0}
        />
        <p class="summary">{p.summary}</p>
        <p class="more">
          <a href={ctx.url(p.path)}>
            {ctx.site.labels.readMore}
            <span class="sr"> {p.title}</span>
          </a>
        </p>
      </Panel>
    ))}
  </div>

  <Caption fig={fig ? String(fig) : null} title={data.title} panels={P} />
</Layout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: var(--row-gap);
  }
  h1 {
    margin-bottom: 0.75rem;
    font-size: var(--s3);
    font-weight: 400;
    line-height: 1.18;
  }
  .lede {
    font-size: var(--s1);
    line-height: 1.4;
  }
  .research {
    grid-auto-flow: dense;
  }
  .research :global(.lead) {
    grid-column: 1 / 8;
    grid-row: span 2;
  }
  .research :global(.side) {
    grid-column: 9 / 13;
  }
  @media (max-width: 1099px) {
    .research :global(.lead),
    .research :global(.side) {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
  .summary {
    max-width: 52ch;
    margin-top: 0.9rem;
  }
  .more {
    font-size: 0.94rem;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
