---
import type { ThemeContext } from '../../contract';
import type { ProjectData } from '../../../lib/types';
import Layout from '../Layout.astro';
import Caption from '../components/Caption.astro';
import DraftMark from '../components/DraftMark.astro';
import FigImage from '../components/FigImage.astro';
import Panel from '../components/Panel.astro';
import Portrait from '../components/Portrait.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { figureNumber, letter, panels } from '../lib';

interface Props {
  ctx: ThemeContext;
  data: ProjectData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t, labels } = ctx.site;
const research = ctx.site.nav.find((n) => n.key === 'research')!;
const section = figureNumber(ctx.site.nav, ctx.currentPath);
const fig = section ? `${section}${letter(data.number - 1)}` : null;
const descs = [
  [data.figure.caption, data.figure.credit].filter(Boolean).join(' '),
  labels.overview,
  ...(data.members.length ? [t.projectPeople] : []),
  ...(data.publications.length ? [t.projectPublications] : []),
];
const P = panels(descs);
const pPeople = data.members.length ? P[2] : undefined;
const pPubs = data.publications.length ? P[data.members.length ? 3 : 2] : undefined;
---

<Layout ctx={ctx} title={data.title} description={data.summary}>
  <header class="page-head">
    <h1>{data.title}</h1>
    <p class="lede">
      {data.summary} <DraftMark ctx={ctx} placeholder={data.placeholder} />
    </p>
  </header>

  <div class="mosaic project">
    <Panel letter={P[0]!.letter} area="a">
      <FigImage figure={data.figure} sizes="(min-width: 1100px) 52rem, 100vw" />
    </Panel>

    <Panel letter={P[1]!.letter} area="b">
      <div class="prose" set:html={data.bodyHtml} />
      {data.repo && (
        <p>
          <a href={data.repo}>{labels.code}</a>
        </p>
      )}
    </Panel>

    {pPeople && (
      <Panel letter={pPeople.letter} area="c" title={t.projectPeople}>
        <ul class="people">
          {data.members.map((m) => (
            <li>
              <Portrait member={m} sizes="6rem" />
              <span>
                <span class="name">{m.name}</span>
                <span class="role">{m.role}</span>
              </span>
            </li>
          ))}
        </ul>
      </Panel>
    )}

    {pPubs && (
      <Panel letter={pPubs.letter} area="d" title={t.projectPublications}>
        <ol class="refs">
          {data.publications.map((p) => (
            <li>
              <PublicationEntry ctx={ctx} pub={p} />
            </li>
          ))}
        </ol>
      </Panel>
    )}
  </div>

  <Caption fig={fig} title={data.title} panels={P} />

  <nav class="pager" aria-label={research.label}>
    {data.prev && (
      <a href={ctx.url(data.prev.path)} rel="prev">
        <span class="no">
          Fig. {section}
          {letter(data.prev.number - 1)}
        </span>{' '}
        {data.prev.title}
      </a>
    )}
    {data.next && (
      <a href={ctx.url(data.next.path)} rel="next">
        <span class="no">
          Fig. {section}
          {letter(data.next.number - 1)}
        </span>{' '}
        {data.next.title}
      </a>
    )}
    <a href={ctx.url(research.path)}>{labels.allProjects}</a>
  </nav>
</Layout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: var(--row-gap);
  }
  h1 {
    margin-bottom: 0.75rem;
    font-size: var(--s3);
    font-weight: 400;
    line-height: 1.18;
  }
  .lede {
    font-size: var(--s1);
    line-height: 1.4;
  }
  .project {
    grid-template-areas:
      'a a a a a a a a c c c c'
      'b b b b b b b . d d d d';
  }
  @media (max-width: 1099px) {
    .project {
      grid-template-areas:
        'a a a a a a a a a a a a'
        'b b b b b b b b b b b b'
        'c c c c c c d d d d d d';
    }
  }
  .people {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    align-items: center;
    font-size: var(--s-1);
  }
  .name {
    display: block;
    font-weight: 700;
  }
  .role {
    display: block;
    color: var(--grey);
  }
  .refs {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 2.5rem;
    font-size: 0.94rem;
  }
  .pager a {
    display: inline-block;
    padding-block: 4px;
  }
  .no {
    color: var(--grey);
    font-variant-numeric: tabular-nums;
  }
</style>
