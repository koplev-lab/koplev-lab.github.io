---
/** Thin L-shaped axes with ticks: the frame of a plot with no data in it yet. */
---

<svg
  class="axes"
  viewBox="0 0 400 300"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="var(--black)" stroke-width="1" vector-effect="non-scaling-stroke" fill="none">
    <path d="M0.5 0 V299.5 H400" vector-effect="non-scaling-stroke"></path>
    {[0, 100, 200, 300, 400].map((x) => (
      <path d={`M${x === 0 ? 0.5 : x - 0.5} 299.5 v-6`} vector-effect="non-scaling-stroke" />
    ))}
    {[0, 75, 150, 225].map((y) => (
      <path d={`M0.5 ${y + 0.5} h6`} vector-effect="non-scaling-stroke" />
    ))}
  </g>
</svg>

<style>
  .axes {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
