---
/**
 * One lettered panel of the page's figure. The letter is referenced in the
 * page caption (see lib.ts `panels`).
 */
interface Props {
  letter: string;
  /** Optional panel title (an h2). */
  title?: string | undefined;
  /** Named grid area in the page's mosaic. */
  area?: string | undefined;
  class?: string | undefined;
}
const { letter, title, area, class: className } = Astro.props;
const id = `panel-${letter}`;
---

<section
  class:list={['panel', className]}
  style={area ? `grid-area: ${area}` : undefined}
  aria-labelledby={title ? id : undefined}
>
  <div class="head">
    <span class="letter">{letter}</span>
    {title && <h2 id={id}>{title}</h2>}
    <slot name="mark" />
  </div>
  <slot />
</section>

<style>
  .panel {
    min-width: 0;
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    margin-bottom: 0.9rem;
  }
  .letter {
    font-weight: 700;
    font-size: var(--s1);
    line-height: 1;
    min-width: 0.7em;
  }
  h2 {
    font-size: var(--s0);
    font-weight: 700;
  }
</style>
