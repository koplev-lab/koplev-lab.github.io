---
/** The journal-style figure caption that closes every page. */
import { sentence, type PanelRef } from '../lib';

interface Props {
  /** Figure number, e.g. "3" or "2a". Omit for unnumbered pages. */
  fig?: string | null | undefined;
  title: string;
  panels: PanelRef[];
}
const { fig, title, panels } = Astro.props;
---

<p class="caption">
  <strong>
    {fig && <span class="tnum">Fig. {fig} | </span>}
    {sentence(title)}
  </strong>
  {panels.map((p) => (
    <>
      {' '}
      <strong>{p.letter}</strong>, {sentence(p.desc)}
    </>
  ))}
</p>

<style>
  .caption {
    max-width: 84ch;
    margin: var(--row-gap) 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
  }
</style>
