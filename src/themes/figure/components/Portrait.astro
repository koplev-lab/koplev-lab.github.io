---
/** Square portrait; members without a photo get the "no data" marker. */
import { Picture } from 'astro:assets';
import type { MemberView } from '../../../lib/types';

interface Props {
  member: MemberView;
  sizes?: string | undefined;
}
const { member, sizes = '(min-width: 1100px) 12rem, 45vw' } = Astro.props;
---

<div class="portrait">
  {member.photo ? (
    <Picture
      src={member.photo.src}
      alt={member.photo.alt}
      widths={[200, 400, 600]}
      sizes={sizes}
      formats={['avif', 'webp']}
    />
  ) : (
    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <rect width="100" height="100" fill="var(--empty)" />
      <circle cx="50" cy="50" r="9" fill="none" stroke="var(--black)" stroke-width="1.5" />
    </svg>
  )}
</div>

<style>
  .portrait {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--empty);
  }
  .portrait :global(picture),
  .portrait :global(img),
  svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
