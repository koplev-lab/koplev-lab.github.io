---
import type { ThemeContext } from '../../contract';
import type { ResearchData } from '../../../lib/types';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import Print from '../components/Print.astro';

interface Props {
  ctx: ThemeContext;
  data: ResearchData;
}
const { ctx, data } = Astro.props;
---

<Layout ctx={ctx} title={data.title} description={data.lede}>
  <header class="head">
    <h1>{data.title}</h1>
    <p class="lede">
      {data.lede} <DraftMark ctx={ctx} placeholder={data.placeholder} />
    </p>
    {data.introHtml && <div class="prose" set:html={data.introHtml} />}
  </header>

  {data.projects.map((p) => (
    <section class="spread" aria-labelledby={`p-${p.slug}`}>
      <Print figure={p.figure} number={p.number} sizes="(min-width: 1024px) 56rem, 100vw" />
      <div class="text">
        <h2 id={`p-${p.slug}`}>
          <a href={ctx.url(p.path)}>{p.title}</a>
        </h2>
        <p>
          {p.summary} <DraftMark ctx={ctx} placeholder={p.placeholder} />
        </p>
        <p class="more">
          <a href={ctx.url(p.path)}>
            {ctx.site.labels.readMore}
            <span class="sr"> {p.title}</span>
          </a>
        </p>
      </div>
    </section>
  ))}
</Layout>

<style>
  .head {
    max-width: 44rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  h1 {
    margin-bottom: 1rem;
  }
  .lede {
    font-size: var(--s1);
    line-height: 1.45;
  }
  .spread + .spread {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .text {
    max-width: 44rem;
    margin-top: 1.75rem;
  }
  h2 {
    margin-bottom: 0.75rem;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
  }
  .text p:first-of-type {
    font-size: var(--s1);
    line-height: 1.45;
  }
  .more {
    font-weight: 700;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
