---
import type { ThemeContext } from '../../contract';
import type { PublicationsData } from '../../../lib/types';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import Print from '../components/Print.astro';
import PublicationEntry from '../components/PublicationEntry.astro';

interface Props {
  ctx: ThemeContext;
  data: PublicationsData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t } = ctx.site;
---

<Layout ctx={ctx} title={data.title}>
  <h1>{data.title}</h1>

  <section class="block" aria-labelledby="pubs-highlights">
    <h2 id="pubs-highlights">{t.highlights}</h2>
    {data.highlights.map((h) => (
      <article class="highlight">
        <h3>
          {h.publication.title} <DraftMark ctx={ctx} placeholder={h.placeholder} />
        </h3>
        <div class="highlight-body">
          <Print figure={h.figure} sizes="(min-width: 1024px) 30rem, 100vw" />
          <div class="text">
            <p class="finding">{h.blurb}</p>
            <PublicationEntry ctx={ctx} pub={h.publication} hideTitle />
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="block" aria-labelledby="pubs-all">
    <h2 id="pubs-all">{t.allPublications}</h2>
    {data.byYear.map((group) => (
      <section class="year" aria-labelledby={`y${group.year}`}>
        <h3 id={`y${group.year}`} class="year-head">
          {group.year}
        </h3>
        <ol>
          {group.items.map((p) => (
            <li>
              <PublicationEntry ctx={ctx} pub={p} />
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>
</Layout>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }
  .block {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .block > h2 {
    margin-bottom: 2rem;
  }
  /* Each highlight is one unit, like the projects: rule, title, then figure beside text. */
  .highlight {
    padding-top: 1.1rem;
    border-top: 2px solid var(--pink);
  }
  .highlight:first-of-type {
    padding-top: 0;
    border-top: 0;
  }
  .highlight + .highlight {
    margin-top: clamp(3.5rem, 6vw, 5rem);
  }
  .highlight h3 {
    max-width: 48rem;
    margin-bottom: 1.25rem;
    font-size: var(--s1);
  }
  .highlight-body {
    display: grid;
    grid-template-columns: fit-content(50%) minmax(16rem, 1fr);
    gap: var(--gutter) calc(var(--gutter) * 2);
    align-items: start;
  }
  .highlight-body :global(.plate img) {
    width: auto;
    max-width: 100%;
    max-height: 22rem;
  }
  .highlight .text {
    max-width: 34rem;
  }
  .finding {
    margin-top: -0.2em;
    font-size: var(--s1);
    font-weight: 700;
    line-height: 1.4;
  }
  @media (max-width: 719px) {
    .highlight-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .highlight-body :global(.plate img) {
      max-height: 18rem;
    }
  }
  .year {
    max-width: 50rem;
  }
  .year + .year {
    margin-top: 2.5rem;
  }
  .year-head {
    margin-bottom: 1rem;
    color: var(--blue);
    font-weight: 900;
    font-size: var(--s2);
    font-variant-numeric: tabular-nums;
  }
  .year ol {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
