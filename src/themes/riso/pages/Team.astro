---
import type { ThemeContext } from '../../contract';
import type { TeamData } from '../../../lib/types';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import Portrait from '../components/Portrait.astro';

interface Props {
  ctx: ThemeContext;
  data: TeamData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t, labels } = ctx.site;
const slug = (s: string) => s.toLowerCase().replace(/\W+/g, '-');
---

<Layout ctx={ctx} title={data.title}>
  <h1>{data.title}</h1>

  <section class="block" aria-labelledby="team-current">
    <h2 id="team-current">{t.currentMembers}</h2>
    {data.groups.map((g) => (
      <section class="group" aria-labelledby={`role-${slug(g.role)}`}>
        <h3 id={`role-${slug(g.role)}`}>{g.label}</h3>
        <ul class="members">
          {g.members.map((m) => (
            <li>
              <Portrait member={m} />
              <p class="name">
                {m.name} <DraftMark ctx={ctx} placeholder={m.placeholder} />
              </p>
              <p class="role">{m.role}</p>
              {m.bioHtml && <div class="bio" set:html={m.bioHtml} />}
              {m.links.length > 0 && (
                <ul class="links">
                  {m.links.map((l) => (
                    <li>
                      <a href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>

  <section class="block" aria-labelledby="team-alumni">
    <h2 id="team-alumni">{t.alumni}</h2>
    {data.alumni.length > 0 ? (
      <ul class="alumni">
        {data.alumni.map((m) => (
          <li>
            <strong>{m.name}</strong> {m.role}
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">{labels.noAlumni}</p>
    )}
  </section>
</Layout>

<style>
  .block {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .block > h2 {
    margin-bottom: 1.75rem;
  }
  .group + .group {
    margin-top: 3rem;
  }
  .group h3 {
    margin-bottom: 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--pink);
  }
  .members {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem calc(var(--gutter) * 1.5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .name {
    margin: 0.75rem 0 0;
    font-weight: 700;
  }
  .role {
    margin: 0 0 0.6rem;
    color: var(--overprint-soft);
  }
  .bio {
    font-size: var(--s-1);
    line-height: 1.5;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--s-1);
  }
  .links a {
    display: inline-block;
    padding-block: 4px;
  }
  .alumni {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .empty {
    color: var(--overprint-soft);
  }
  @media (max-width: 1199px) {
    .members {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 719px) {
    .members {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
