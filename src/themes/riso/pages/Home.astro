---
import type { ThemeContext } from '../../contract';
import type { HomeData } from '../../../lib/types';
import StainingRun from '../../../islands/staining-run/StainingRun.astro';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import Print from '../components/Print.astro';
import PublicationEntry from '../components/PublicationEntry.astro';

interface Props {
  ctx: ThemeContext;
  data: HomeData;
}
const { ctx, data } = Astro.props;
const { site } = ctx;
const { sectionTitles: t, labels } = site;
const nav = Object.fromEntries(site.nav.map((n) => [n.key, n]));
const more = data.highlights;
---

<Layout ctx={ctx}>
  <div class="cover">
    <StainingRun alt={data.figure.alt} />
  </div>

  <section class="opening">
    <div class="statement">
      <h1>{data.tagline}</h1>
      <DraftMark ctx={ctx} placeholder={data.placeholder} />
    </div>
    <div class="intro" set:html={data.introHtml} />
  </section>

  <section class="block" aria-labelledby="home-research">
    <h2 id="home-research">{t.projects}</h2>
    <ol class="projects">
      {data.projects.map((p) => (
        <li>
          <Print figure={p.figure} details={false} sizes="(min-width: 1024px) 30rem, 100vw" />
          <div class="text">
            <h3>
              <a href={ctx.url(p.path)}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
            <DraftMark ctx={ctx} placeholder={p.placeholder} />
          </div>
        </li>
      ))}
    </ol>
    <p class="more">
      <a href={ctx.url(nav.research!.path)}>{labels.allProjects}</a>
    </p>
  </section>

  {more.length > 0 && (
    <section class="block" aria-labelledby="home-highlights">
      <h2 id="home-highlights">{t.highlights}</h2>
      <ul class="highlights">
        {more.map((h) => (
          <li>
            <Print
              figure={h.figure}
              number={h.number}
              details={false}
              sizes="(min-width: 1024px) 26rem, 100vw"
            />
            <p class="finding">{h.blurb}</p>
            <PublicationEntry ctx={ctx} pub={h.publication} />
            <p class="credit mono">{h.figure.credit}</p>
          </li>
        ))}
      </ul>
      <p class="more">
        <a href={ctx.url(nav.publications!.path)}>{labels.allPublications}</a>
      </p>
    </section>
  )}
</Layout>

<style>
  .cover {
    margin: 0 0 clamp(1.75rem, 3vw, 2.75rem);
    /* H&E as two inks: hematoxylin prints blue, eosin prints pink; where they overlap the
       nuclei multiply to the overprint colour. */
    --hero-bg: var(--paper);
    --hero-hematoxylin: var(--blue);
    --hero-eosin: var(--pink);
    --hero-unstained: #a8a294;
  }
  /* Statement and intro side by side under the image. */
  .opening {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1rem calc(var(--gutter) * 3);
    align-items: start;
  }
  h1 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.6rem, 0.9rem + 1.3vw, 1.8rem);
    line-height: 1.08;
  }
  .intro {
    max-width: 34rem;
    padding-top: 0.2rem;
    font-size: 1.1rem;
    line-height: 1.55;
  }
  .intro :global(p:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 899px) {
    .opening {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .block {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .block h2 {
    margin-bottom: 1.75rem;
  }
  .more {
    margin-top: 1.5rem;
    font-weight: 700;
  }

  .projects {
    display: grid;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects li {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--gutter) calc(var(--gutter) * 2);
    align-items: start;
  }
  .projects li :global(.plate img) {
    width: auto;
    max-width: 100%;
    max-height: 22rem;
  }
  .projects h3 {
    margin-bottom: 0.5rem;
    font-size: var(--s1);
  }
  .projects h3 a {
    text-decoration: none;
  }
  .projects h3 a:hover {
    text-decoration: underline;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem calc(var(--gutter) * 2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .finding {
    margin: 1rem 0 0.6rem;
    font-weight: 700;
  }
  .credit {
    margin-top: 0.6rem;
    color: var(--overprint-soft);
  }

  @media (max-width: 719px) {
    .projects li,
    .highlights {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro {
      font-size: var(--s0);
    }
  }
</style>
