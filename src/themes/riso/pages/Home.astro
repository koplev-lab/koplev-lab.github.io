---
import type { ThemeContext } from '../../contract';
import type { HomeData } from '../../../lib/types';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import Portrait from '../components/Portrait.astro';
import Print from '../components/Print.astro';
import PublicationEntry from '../components/PublicationEntry.astro';

interface Props {
  ctx: ThemeContext;
  data: HomeData;
}
const { ctx, data } = Astro.props;
const { site } = ctx;
const { sectionTitles: t, labels } = site;
const nav = Object.fromEntries(site.nav.map((n) => [n.key, n]));
// Until the interactive tissue map exists (Phase 4), the cover is the first
// landscape highlight figure (a tall one would push the tagline off the first
// screen); the remaining highlights follow further down.
const landscape = (h: (typeof data.highlights)[number]) =>
  h.figure.src.width / h.figure.src.height >= 1.4;
const cover = data.highlights.find(landscape) ?? data.highlights[0];
const more = data.highlights.filter((h) => h !== cover);
---

<Layout ctx={ctx}>
  {cover && (
    <div class="cover">
      <Print
        ctx={ctx}
        figure={cover.figure}
        caption={cover.publication.title}
        number={cover.number}
        sizes="(min-width: 1024px) 56rem, 100vw"
      />
    </div>
  )}

  <section class="opening">
    <h1>{data.tagline}</h1>
    <DraftMark ctx={ctx} placeholder={data.placeholder} />
    <div class="intro" set:html={data.introHtml} />
  </section>

  <section class="block" aria-labelledby="home-research">
    <h2 id="home-research">{t.projects}</h2>
    <ol class="projects">
      {data.projects.map((p) => (
        <li>
          <Print
            ctx={ctx}
            figure={p.figure}
            details={false}
            sizes="(min-width: 1024px) 30rem, 100vw"
          />
          <div class="text">
            <h3>
              <a href={ctx.url(p.path)}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
            <DraftMark ctx={ctx} placeholder={p.placeholder} />
          </div>
        </li>
      ))}
    </ol>
    <p class="more">
      <a href={ctx.url(nav.research!.path)}>{labels.allProjects}</a>
    </p>
  </section>

  {more.length > 0 && (
    <section class="block" aria-labelledby="home-highlights">
      <h2 id="home-highlights">{t.highlights}</h2>
      <ul class="highlights">
        {more.map((h) => (
          <li>
            <Print
              ctx={ctx}
              figure={h.figure}
              number={h.number}
              details={false}
              sizes="(min-width: 1024px) 26rem, 100vw"
            />
            <p class="finding">{h.blurb}</p>
            <PublicationEntry ctx={ctx} pub={h.publication} />
            <p class="credit mono">{h.figure.credit}</p>
          </li>
        ))}
      </ul>
      <p class="more">
        <a href={ctx.url(nav.publications!.path)}>{labels.allPublications}</a>
      </p>
    </section>
  )}

  <section class="block" aria-labelledby="home-people">
    <h2 id="home-people">{nav.team!.label}</h2>
    <ul class="people">
      {data.members.map((m) => (
        <li>
          <Portrait member={m} sizes="8rem" />
          <span class="name">{m.name}</span>
          <span class="role">{m.role}</span>
        </li>
      ))}
    </ul>
    <p class="more">
      <a href={ctx.url(nav.team!.path)}>{labels.allMembers}</a>
    </p>
  </section>

  <section class="block join" aria-labelledby="home-join">
    <h2 id="home-join">{t.join}</h2>
    <p>{data.join.lede}</p>
    <p class="more">
      <a href={ctx.url(data.join.path)}>{data.join.title}</a>
    </p>
  </section>
</Layout>

<style>
  .cover {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .opening {
    max-width: 44rem;
  }
  h1 {
    margin-bottom: 1.25rem;
  }
  .intro {
    max-width: var(--measure);
    margin-top: 1rem;
    font-size: var(--s1);
    line-height: 1.5;
  }

  .block {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .block h2 {
    margin-bottom: 1.75rem;
  }
  .more {
    margin-top: 1.5rem;
    font-weight: 700;
  }

  .projects {
    display: grid;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects li {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--gutter) calc(var(--gutter) * 2);
    align-items: start;
  }
  .projects li :global(.plate img) {
    width: auto;
    max-width: 100%;
    max-height: 22rem;
  }
  .projects h3 {
    margin-bottom: 0.5rem;
    font-size: var(--s1);
  }
  .projects h3 a {
    text-decoration: none;
  }
  .projects h3 a:hover {
    text-decoration: underline;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem calc(var(--gutter) * 2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .finding {
    margin: 1rem 0 0.6rem;
    font-weight: 700;
  }
  .credit {
    margin-top: 0.6rem;
    color: var(--overprint-soft);
  }

  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: 1.75rem var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people li {
    font-size: var(--s-1);
    line-height: 1.35;
  }
  .name {
    display: block;
    margin-top: 0.6rem;
    font-weight: 700;
  }
  .role {
    display: block;
    color: var(--overprint-soft);
  }

  .join {
    max-width: 44rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--pink-tint);
  }
  .join h2 {
    color: var(--overprint);
    margin-bottom: 1rem;
  }

  @media (max-width: 719px) {
    .projects li,
    .highlights {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro {
      font-size: var(--s0);
    }
  }
</style>
