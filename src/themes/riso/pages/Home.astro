---
import type { ThemeContext } from '../../contract';
import type { HomeData } from '../../../lib/types';
import StainingRun from '../../../islands/staining-run/StainingRun.astro';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import Print from '../components/Print.astro';
import PublicationEntry from '../components/PublicationEntry.astro';

interface Props {
  ctx: ThemeContext;
  data: HomeData;
}
const { ctx, data } = Astro.props;
const { site } = ctx;
const { sectionTitles: t, labels } = site;
const nav = Object.fromEntries(site.nav.map((n) => [n.key, n]));
const more = data.highlights;
---

<Layout ctx={ctx}>
  <figure class="cover">
    <StainingRun
      alt={data.figure.alt}
      steps={data.figure.steps}
      pauseLabel={labels.pauseAnimation}
      playLabel={labels.playAnimation}
    />
    <figcaption class="mono">
      <span class="no">{data.figure.title}.</span>
      <span>{data.figure.caption}</span>
    </figcaption>
  </figure>

  <section class="opening">
    <h1>{data.tagline}</h1>
    <DraftMark ctx={ctx} placeholder={data.placeholder} />
    <div class="intro" set:html={data.introHtml} />
  </section>

  <section class="block" aria-labelledby="home-research">
    <h2 id="home-research">{t.projects}</h2>
    <ol class="projects">
      {data.projects.map((p) => (
        <li>
          <Print figure={p.figure} details={false} sizes="(min-width: 1024px) 30rem, 100vw" />
          <div class="text">
            <h3>
              <a href={ctx.url(p.path)}>{p.title}</a>
            </h3>
            <p>{p.summary}</p>
            <DraftMark ctx={ctx} placeholder={p.placeholder} />
          </div>
        </li>
      ))}
    </ol>
    <p class="more">
      <a href={ctx.url(nav.research!.path)}>{labels.allProjects}</a>
    </p>
  </section>

  {more.length > 0 && (
    <section class="block" aria-labelledby="home-highlights">
      <h2 id="home-highlights">{t.highlights}</h2>
      <ul class="highlights">
        {more.map((h) => (
          <li>
            <Print
              figure={h.figure}
              number={h.number}
              details={false}
              sizes="(min-width: 1024px) 26rem, 100vw"
            />
            <p class="finding">{h.blurb}</p>
            <PublicationEntry ctx={ctx} pub={h.publication} />
            <p class="credit mono">{h.figure.credit}</p>
          </li>
        ))}
      </ul>
      <p class="more">
        <a href={ctx.url(nav.publications!.path)}>{labels.allPublications}</a>
      </p>
    </section>
  )}
</Layout>

<style>
  .cover {
    margin: 0 0 clamp(2rem, 4vw, 3.5rem);
    /* H&E as two inks: hematoxylin prints blue, eosin prints pink; where they overlap the
       nuclei multiply to the overprint colour. */
    --hero-bg: var(--paper);
    --hero-hematoxylin: var(--blue);
    --hero-eosin: var(--pink);
    --hero-unstained: #a8a294;
  }
  .cover :global(.staining-run-steps) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5em;
    font-family: var(--mono);
    font-size: var(--s-1);
    color: var(--overprint-soft);
  }
  .cover :global(.staining-run-steps [aria-current]) {
    color: var(--overprint);
    font-weight: 700;
  }
  .cover :global(.staining-run-toggle) {
    min-height: 24px;
    padding: 2px 10px;
    border: 1.5px solid var(--overprint);
    border-radius: 0;
    background: var(--paper);
    color: var(--overprint);
    font: 700 var(--s-1) / 1.4 var(--mono);
    cursor: pointer;
  }
  .cover :global(.staining-run-toggle:hover) {
    background: var(--pink-tint);
  }
  .cover figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9em;
    max-width: 70ch;
    margin-top: 1rem;
  }
  .cover .no {
    color: var(--overprint);
    font-weight: 700;
  }
  .opening {
    max-width: 44rem;
  }
  h1 {
    margin-bottom: 1.25rem;
  }
  .intro {
    max-width: var(--measure);
    margin-top: 1rem;
    font-size: var(--s1);
    line-height: 1.5;
  }

  .block {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .block h2 {
    margin-bottom: 1.75rem;
  }
  .more {
    margin-top: 1.5rem;
    font-weight: 700;
  }

  .projects {
    display: grid;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projects li {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--gutter) calc(var(--gutter) * 2);
    align-items: start;
  }
  .projects li :global(.plate img) {
    width: auto;
    max-width: 100%;
    max-height: 22rem;
  }
  .projects h3 {
    margin-bottom: 0.5rem;
    font-size: var(--s1);
  }
  .projects h3 a {
    text-decoration: none;
  }
  .projects h3 a:hover {
    text-decoration: underline;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem calc(var(--gutter) * 2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .finding {
    margin: 1rem 0 0.6rem;
    font-weight: 700;
  }
  .credit {
    margin-top: 0.6rem;
    color: var(--overprint-soft);
  }

  @media (max-width: 719px) {
    .projects li,
    .highlights {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro {
      font-size: var(--s0);
    }
  }
</style>
