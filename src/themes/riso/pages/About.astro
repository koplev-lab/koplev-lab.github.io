---
import type { ThemeContext } from '../../contract';
import type { AboutData } from '../../../lib/types';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';

interface Props {
  ctx: ThemeContext;
  data: AboutData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t } = ctx.site;
---

<Layout ctx={ctx} title={data.title} description={data.lede}>
  <h1>{data.title}</h1>
  <p class="lede">
    {data.lede} <DraftMark ctx={ctx} placeholder={data.placeholder} />
  </p>
  <div class="prose" set:html={data.bodyHtml} />

  <section class="block" aria-labelledby="about-aff">
    <h2 id="about-aff">{t.affiliations}</h2>
    <ul class="plain">
      {data.affiliations.map((a) => (
        <li>
          <a href={a.url}>{a.name}</a>
        </li>
      ))}
    </ul>
  </section>

  {data.funders.length > 0 && (
    <section class="block" aria-labelledby="about-funders">
      <h2 id="about-funders">{t.funders}</h2>
      <ul class="plain">
        {data.funders.map((f) => (
          <li>
            <a href={f.url}>{f.name}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<style>
  h1 {
    margin-bottom: 1.75rem;
  }
  .lede {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--blue-tint);
    font-size: var(--s1);
    font-weight: 700;
    line-height: 1.4;
  }
  .block {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .block h2 {
    margin-bottom: 1rem;
  }
  .plain {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plain a {
    display: inline-block;
    padding-block: 4px;
  }
</style>
