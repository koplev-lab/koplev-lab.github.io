---
import type { ThemeContext } from '../../contract';
import type { JoinData } from '../../../lib/types';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';

interface Props {
  ctx: ThemeContext;
  data: JoinData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t } = ctx.site;
---

<Layout ctx={ctx} title={data.title} description={data.lede}>
  <h1>{data.title}</h1>
  <p class="lede">
    {data.lede} <DraftMark ctx={ctx} placeholder={data.placeholder} />
  </p>
  <div class="prose" set:html={data.bodyHtml} />

  <section class="contact" aria-labelledby="join-contact">
    <h2 id="join-contact">{t.contact}</h2>
    <p class="email">
      <a href={`mailto:${data.contact.email}`}>{data.contact.email}</a>
    </p>
    {data.contact.address && <address>{data.contact.address}</address>}
  </section>
</Layout>

<style>
  h1 {
    margin-bottom: 1.75rem;
  }
  .lede {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--pink-tint);
    font-size: var(--s1);
    font-weight: 700;
    line-height: 1.4;
  }
  .contact {
    max-width: 40rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .contact h2 {
    margin-bottom: 0.75rem;
  }
  .email {
    font-size: var(--s1);
    font-weight: 700;
  }
  address {
    font-style: normal;
  }
</style>
