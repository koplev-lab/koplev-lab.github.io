---
import type { ThemeContext } from '../../contract';
import type { ProjectData } from '../../../lib/types';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import Portrait from '../components/Portrait.astro';
import Print from '../components/Print.astro';
import PublicationEntry from '../components/PublicationEntry.astro';

interface Props {
  ctx: ThemeContext;
  data: ProjectData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t, labels } = ctx.site;
const research = ctx.site.nav.find((n) => n.key === 'research')!;
---

<Layout ctx={ctx} title={data.title} description={data.summary}>
  <header class="head">
    <h1>{data.title}</h1>
    <p class="lede">
      {data.summary} <DraftMark ctx={ctx} placeholder={data.placeholder} />
    </p>
  </header>

  <Print figure={data.figure} number={data.number} sizes="(min-width: 1024px) 56rem, 100vw" />

  <div class="body prose" set:html={data.bodyHtml} />
  {data.repo && (
    <p>
      <a href={data.repo}>{labels.code}</a>
    </p>
  )}

  {data.members.length > 0 && (
    <section class="block" aria-labelledby="proj-people">
      <h2 id="proj-people">{t.projectPeople}</h2>
      <ul class="people">
        {data.members.map((m) => (
          <li>
            <Portrait member={m} sizes="8rem" />
            <span class="name">{m.name}</span>
            <span class="role">{m.role}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {data.publications.length > 0 && (
    <section class="block" aria-labelledby="proj-pubs">
      <h2 id="proj-pubs">{t.projectPublications}</h2>
      <ol class="refs">
        {data.publications.map((p) => (
          <li>
            <PublicationEntry ctx={ctx} pub={p} />
          </li>
        ))}
      </ol>
    </section>
  )}

  <nav class="pager" aria-label={research.label}>
    {data.prev && (
      <a href={ctx.url(data.prev.path)} rel="prev">
        {data.prev.title}
      </a>
    )}
    <a href={ctx.url(research.path)}>{labels.allProjects}</a>
    {data.next && (
      <a href={ctx.url(data.next.path)} rel="next">
        {data.next.title}
      </a>
    )}
  </nav>
</Layout>

<style>
  .head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  h1 {
    margin-bottom: 1rem;
  }
  .lede {
    font-size: var(--s1);
    line-height: 1.45;
  }
  .body {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .block {
    margin-top: clamp(3rem, 6vw, 5rem);
    max-width: 46rem;
  }
  .block h2 {
    margin-bottom: 1.25rem;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 9rem));
    gap: 1.5rem var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people li {
    font-size: var(--s-1);
  }
  .name {
    display: block;
    margin-top: 0.5rem;
    font-weight: 700;
  }
  .role {
    display: block;
    color: var(--overprint-soft);
  }
  .refs {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1rem;
    border-top: 2px solid var(--blue-tint);
    font-weight: 700;
  }
  .pager a {
    display: inline-block;
    padding-block: 4px;
  }
</style>
