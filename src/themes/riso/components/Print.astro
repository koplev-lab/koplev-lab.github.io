---
/**
 * An image printed in two inks (see the #riso-print filter in Layout.astro).
 * The caption is set in mono like a zine's figure note, with the credit and a
 * link to the unaltered original, because the two-ink version loses colour.
 */
import { Picture } from 'astro:assets';
import type { ThemeContext } from '../../contract';
import type { Figure } from '../../../lib/types';

interface Props {
  ctx: ThemeContext;
  figure: Figure;
  sizes?: string | undefined;
  /** Optional caption text (defaults to the figure's own caption). */
  caption?: string | undefined;
  /** Figure number shown before the caption. */
  number?: number | undefined;
  /** Show credit and original link (off for small thumbnails with a nearby credit). */
  details?: boolean | undefined;
}
const {
  ctx,
  figure,
  sizes = '(min-width: 1024px) 50rem, 100vw',
  caption = figure.caption,
  number,
  details = true,
} = Astro.props;
---

<figure class="print">
  <div class="plate">
    <Picture
      src={figure.src}
      alt={figure.alt}
      widths={[480, 960, 1440, 1920]}
      sizes={sizes}
      formats={['avif', 'webp']}
      class="print-img"
    />
  </div>
  {(caption || number !== undefined || (details && figure.credit)) && (
    <figcaption class="mono">
      {number !== undefined && <span class="no">Fig. {number}</span>}
      {caption && <span>{caption}</span>}
      {details && figure.credit && <span class="credit">{figure.credit}</span>}
      {details && (
        <a class="original" href={figure.src.src}>
          {ctx.site.labels.originalFigure}
        </a>
      )}
    </figcaption>
  )}
</figure>

<style>
  .print {
    margin: 0;
  }
  .plate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: url(#riso-print);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9em;
    margin-top: 0.6rem;
    max-width: 70ch;
  }
  .no {
    color: var(--overprint);
    font-weight: 700;
  }
  .credit {
    color: var(--overprint-soft);
  }
  .original {
    color: var(--overprint-soft);
  }
</style>
