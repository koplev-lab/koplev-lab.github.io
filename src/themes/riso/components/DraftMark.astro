---
import type { ThemeContext } from '../../contract';

interface Props {
  ctx: ThemeContext;
  placeholder: boolean;
}
const { ctx, placeholder } = Astro.props;
---

{ctx.showDrafts && placeholder && <span class="draft mono">{ctx.site.labels.draft}</span>}

<style>
  .draft {
    display: inline-block;
    padding: 0 0.4em;
    background: var(--pink-tint);
    color: var(--overprint);
    font-weight: 400;
    vertical-align: 0.15em;
  }
</style>
