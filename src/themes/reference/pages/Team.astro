---
import type { ThemeContext } from '../../contract';
import type { TeamData } from '../../../lib/types';
import Layout from '../Layout.astro';
import MemberEntry from '../components/MemberEntry.astro';

interface Props {
  ctx: ThemeContext;
  data: TeamData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t, labels } = ctx.site;
---

<Layout ctx={ctx} title={data.title}>
  <h1>{data.title}</h1>

  <section aria-labelledby="team-current">
    <h2 id="team-current">{t.currentMembers}</h2>
    {data.rows.map((row) => (
      <div class="row">
        {row.map((m) => (
          <MemberEntry ctx={ctx} member={m} />
        ))}
      </div>
    ))}
  </section>

  <section aria-labelledby="team-alumni">
    <h2 id="team-alumni">{t.alumni}</h2>
    {data.alumni.length > 0 ? (
      data.alumni.map((m) => <MemberEntry ctx={ctx} member={m} />)
    ) : (
      <p>{labels.noAlumni}</p>
    )}
  </section>
</Layout>
