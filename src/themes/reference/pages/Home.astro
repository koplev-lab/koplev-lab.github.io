---
import type { ThemeContext } from '../../contract';
import type { HomeData } from '../../../lib/types';
import StainingRun from '../../../islands/staining-run/StainingRun.astro';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';
import FigureBlock from '../components/FigureBlock.astro';
import PublicationEntry from '../components/PublicationEntry.astro';

interface Props {
  ctx: ThemeContext;
  data: HomeData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t, labels } = ctx.site;
const nav = Object.fromEntries(ctx.site.nav.map((n) => [n.key, n]));
---

<Layout ctx={ctx}>
  <h1>{data.tagline}</h1>
  <DraftMark ctx={ctx} placeholder={data.placeholder} />
  <Fragment set:html={data.introHtml} />

  <section aria-labelledby="home-figure">
    <h2 id="home-figure">{data.figure.title}</h2>
    <StainingRun
      alt={data.figure.alt}
      steps={data.figure.steps}
      pauseLabel={labels.pauseAnimation}
      playLabel={labels.playAnimation}
    />
    <p>{data.figure.caption}</p>
  </section>

  <section aria-labelledby="home-projects">
    <h2 id="home-projects">{t.projects}</h2>
    <ol>
      {data.projects.map((p) => (
        <li>
          <h3>
            <a href={ctx.url(p.path)}>{p.title}</a>
          </h3>
          <p>
            {p.summary} <DraftMark ctx={ctx} placeholder={p.placeholder} />
          </p>
        </li>
      ))}
    </ol>
    <p>
      <a href={ctx.url(nav.research!.path)}>{labels.allProjects}</a>
    </p>
  </section>

  <section aria-labelledby="home-highlights">
    <h2 id="home-highlights">{t.highlights}</h2>
    {data.highlights.map((h) => (
      <article>
        <FigureBlock figure={h.figure} caption={h.blurb} number={h.number} />
        <PublicationEntry ctx={ctx} pub={h.publication} />
      </article>
    ))}
    <p>
      <a href={ctx.url(nav.publications!.path)}>{labels.allPublications}</a>
    </p>
  </section>

  <section aria-labelledby="home-vision">
    <h2 id="home-vision">{t.vision}</h2>
    <p>{data.about.lede}</p>
    <p>
      <a href={ctx.url(data.about.path)}>{data.about.title}</a>
    </p>
  </section>
</Layout>
