---
import type { ThemeContext } from '../../contract';
import Layout from '../Layout.astro';

interface Props {
  ctx: ThemeContext;
}
const { ctx } = Astro.props;
const { notFound } = ctx.site.labels;
const home = ctx.site.nav.find((n) => n.key === 'home')!;
---

<Layout ctx={ctx} title={notFound.title}>
  <h1>{notFound.title}</h1>
  <p>{notFound.body}</p>
  <p>
    <a href={ctx.url(home.path)}>{home.label}</a>
  </p>
</Layout>
