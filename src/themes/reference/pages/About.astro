---
import type { ThemeContext } from '../../contract';
import type { AboutData } from '../../../lib/types';
import Layout from '../Layout.astro';
import DraftMark from '../components/DraftMark.astro';

interface Props {
  ctx: ThemeContext;
  data: AboutData;
}
const { ctx, data } = Astro.props;
const { sectionTitles: t } = ctx.site;
---

<Layout ctx={ctx} title={data.title} description={data.lede}>
  <h1>{data.title}</h1>
  <p>
    {data.lede} <DraftMark ctx={ctx} placeholder={data.placeholder} />
  </p>
  <div set:html={data.bodyHtml} />

  <section aria-labelledby="about-affiliations">
    <h2 id="about-affiliations">{t.affiliations}</h2>
    <ul>
      {data.affiliations.map((a) => (
        <li>
          <a href={a.url}>{a.name}</a>
        </li>
      ))}
    </ul>
  </section>

  {data.funders.length > 0 && (
    <section aria-labelledby="about-funders">
      <h2 id="about-funders">{t.funders}</h2>
      <ul>
        {data.funders.map((f) => (
          <li>
            <a href={f.url}>{f.name}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
