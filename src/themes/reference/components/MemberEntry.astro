---
import { Picture } from 'astro:assets';
import type { ThemeContext } from '../../contract';
import type { MemberView } from '../../../lib/types';
import DraftMark from './DraftMark.astro';

interface Props {
  ctx: ThemeContext;
  member: MemberView;
  /** Heading level for the name. */
  level?: 'h3' | 'h4';
}
const { ctx, member, level = 'h3' } = Astro.props;
const Heading = level;
---

<article>
  {member.photo ? (
    <Picture
      src={member.photo.src}
      alt={member.photo.alt}
      widths={[160, 320]}
      sizes="160px"
      formats={['avif', 'webp']}
    />
  ) : (
    <svg width="160" height="160" viewBox="0 0 160 160" aria-hidden="true">
      <rect width="160" height="160" fill="none" stroke="currentColor" />
      <circle cx="80" cy="80" r="40" fill="none" stroke="currentColor" />
    </svg>
  )}
  <Heading>{member.name}</Heading>
  <p>
    {member.role} <DraftMark ctx={ctx} placeholder={member.placeholder} />
  </p>
  {member.bioHtml && <div set:html={member.bioHtml} />}
  {member.links.length > 0 && (
    <ul>
      {member.links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
    </ul>
  )}
</article>
