---
import type { ThemeContext } from '../../contract';
import type { PublicationView } from '../../../lib/types';
import { authorParts } from '../../../lib/authors';

interface Props {
  ctx: ThemeContext;
  pub: PublicationView;
}
const { ctx, pub } = Astro.props;
const { labels } = ctx.site;
const authors = authorParts(pub.authorsBrief);
---

<p>
  <span>{authors.map((a) => (a.member ? <strong>{a.text}</strong> : a.text))}</span>
  {pub.url ? (
    <a href={pub.url}>
      <cite>{`${pub.title}.`}</cite>
    </a>
  ) : (
    <cite>{`${pub.title}.`}</cite>
  )}
  {pub.venue && <em>{pub.venue}</em>}
  <span>({pub.year}).</span>
  {pub.isPreprint && <span>{labels.preprint}.</span>}
  {pub.oaUrl && pub.oaUrl !== pub.url && <a href={pub.oaUrl}>{labels.openAccess}</a>}
  {pub.preprintUrl && <a href={pub.preprintUrl}>{labels.preprint}</a>}
</p>
