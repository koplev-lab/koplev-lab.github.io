---
import { Picture } from 'astro:assets';
import type { Figure } from '../../../lib/types';

interface Props {
  figure: Figure;
  /** Optional caption override (e.g. a highlight blurb). */
  caption?: string | undefined;
  number?: number | undefined;
}
const { figure, caption = figure.caption, number } = Astro.props;
---

<figure>
  <Picture
    src={figure.src}
    alt={figure.alt}
    widths={[480, 960, 1440]}
    sizes="(min-width: 60em) 60em, 100vw"
    formats={['avif', 'webp']}
  />
  <figcaption>
    {number !== undefined && <span>{number}. </span>}
    {caption}
    {figure.credit && <small> {figure.credit}</small>}
  </figcaption>
</figure>
