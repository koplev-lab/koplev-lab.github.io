---
/**
 * Reference theme: plain semantic HTML with no styling. It implements the
 * full contract and is the starting point for new themes (docs/THEMES.md).
 */
import BaseHead from '../../lib/components/BaseHead.astro';
import PreviewBar from '../../lib/components/PreviewBar.astro';
import type { ThemeContext } from '../contract';
import './styles/base.css';

interface Props {
  ctx: ThemeContext;
  title?: string | undefined;
  description?: string | undefined;
}

const { ctx, title, description } = Astro.props;
const { site } = ctx;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead ctx={ctx} title={title} description={description} />
  </head>
  <body>
    <PreviewBar ctx={ctx} />
    <a href="#main">{site.labels.skipToContent}</a>
    <header>
      <p>
        <a href={ctx.url('/')}>
          {site.logoSvg && <span aria-hidden="true" set:html={site.logoSvg} />}
          {site.labName}
        </a>
      </p>
      <nav aria-label={site.labels.mainNav}>
        <ul>
          {site.nav.map((item) => (
            <li>
              <a
                href={ctx.url(item.path)}
                aria-current={ctx.currentPath === item.path ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>{site.labName}</p>
      <ul>
        {site.affiliations.map((a) => (
          <li>
            <a href={a.url}>{a.name}</a>
          </li>
        ))}
      </ul>
      <p>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
      {site.contact.address && <address>{site.contact.address}</address>}
    </footer>
  </body>
</html>
