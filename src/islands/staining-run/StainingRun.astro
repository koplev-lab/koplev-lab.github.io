---
/**
 * The home page's hero: a drawn tissue section being stained with hematoxylin, then eosin.
 * Themes style it only through the --hero-* custom properties (see staining-run.ts).
 */
interface Props {
  /** Text alternative for the drawing. */
  alt: string;
  /** Changes the generated tissue. */
  seed?: number;
  class?: string;
}
const { alt, seed = 11, class: className } = Astro.props;
---

<staining-run class:list={['staining-run', className]} data-seed={seed}>
  <canvas class="staining-run-canvas" role="img" aria-label={alt}></canvas>
</staining-run>

<script>
  import './staining-run';
</script>

<style>
  .staining-run {
    display: block;
  }
  .staining-run-canvas {
    display: block;
    width: 100%;
    aspect-ratio: 686 / 300;
    background: var(--hero-bg, #fbf7f8);
  }
</style>
