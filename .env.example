# Copy to .env for local overrides. All values are optional.
# Active theme (one of the ids in src/themes/ids.ts).
THEME=reference
# Also build every theme under /themes/<id>/ for side-by-side comparison.
PREVIEW_THEMES=false
# SITE_URL and BASE_PATH are read from the shell, not from this file:
#   SITE_URL=https://example.org BASE_PATH=/website npm run build
